<IfModule mod_authz_core.c>
  <FilesMatch "^(?:\.env(?:\..*)?|artisan|composer\.(?:json|lock)|phpunit\.xml|\.gitignore|\.gitattributes|README\.md|SETUP-BN\.md|plan\.md|TODO\.md)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor|\.work)(?:/|$) - [F,L,NC]
</IfModule>
